# Comma-separated browser origins, for example:
# FRONTEND_ORIGINS=https://app.example.com,https://www.example.com
FRONTEND_ORIGINS=

# Task metadata database
MEDIAOPS_DATABASE_PATH=/var/lib/mediaops/mediaops.db

# Comma-separated platform adapters allowed to create/run tasks.
# Enable only platforms that this deployment has enough resources to operate.
# Bilibili, XHS, Zhihu, Weibo, and Tieba are production-verified.
# Douyin is resource-deferred; Kuaishou is upstream-breakage-deferred.
# Keep both deferred platforms disabled until a new real validation passes.
MEDIAOPS_ENABLED_PLATFORMS=bili

# Fixed MediaCrawler interpreter and service-owned runner
MEDIACRAWLER_PYTHON=/opt/mediacrawler/.venv/bin/python
MEDIACRAWLER_RUNNER=/var/lib/mediaops/bin/run_mediacrawler.py

# Per-task output, log, and QR code roots
MEDIAOPS_OUTPUT_ROOT=/var/lib/mediaops/crawler-output
MEDIAOPS_LOG_ROOT=/var/log/mediaops
MEDIAOPS_QRCODE_ROOT=/var/lib/mediaops/qrcodes

# Configure one of these so PyExecJS can find Node.js.
MEDIAOPS_NODE_BINARY=/usr/bin/node
# MEDIAOPS_NODE_BIN_DIR=/usr/bin

# Seconds between queue/cancellation checks
CRAWLER_POLL_INTERVAL_SECONDS=1

# Stop a Douyin browser that cannot expose its login QR code in time.
# This guard ends once the QR code is ready for an operator scan.
DOUYIN_QRCODE_STARTUP_TIMEOUT_SECONDS=180

# Owner-session and low-resource automation controls.
MEDIAOPS_SECURE_SESSION_COOKIE=true
MEDIAOPS_SESSION_LIFETIME_SECONDS=604800
MEDIAOPS_LOGIN_FAILURE_LIMIT=5
MEDIAOPS_LOGIN_LOCKOUT_SECONDS=900
MEDIAOPS_MAX_OWNER_ACCOUNTS=3
MEDIAOPS_AUTOMATION_POLL_INTERVAL_SECONDS=30

# Stage seven briefs are deterministic; external model calls stay disabled.
MEDIAOPS_AI_PROVIDER=disabled

# Phase 8A Model Gateway. The fixed production key file is created by the
# reviewed deployment stage; never put key material in this environment file.
MEDIAOPS_MODEL_GATEWAY_MASTER_KEY_PATH=/var/lib/mediaops/secrets/model-gateway-master.key
MEDIAOPS_MODEL_GATEWAY_MAX_CONNECTIONS=20
MEDIAOPS_MODEL_GATEWAY_MAX_KEEPALIVE_CONNECTIONS=10
