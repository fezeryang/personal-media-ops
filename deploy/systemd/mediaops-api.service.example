[Unit]
Description=Personal Media Ops API
After=network.target

[Service]
Type=simple
User=mediaops
Group=mediaops
WorkingDirectory=/opt/personal-media-ops/backend
EnvironmentFile=/opt/personal-media-ops/backend/.env
ExecStart=/usr/local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
