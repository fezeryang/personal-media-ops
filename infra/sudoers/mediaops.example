# Personal Media Ops deployment permissions example.
# Review paths and arguments on the target host before installing with visudo.
# Do not copy this file automatically from an agent or deployment script.

Cmnd_Alias MEDIAOPS_DEPLOY = \
    /usr/bin/rsync --archive --delete --no-owner --no-group /opt/personal-media-ops/frontend/dist/ /www/wwwroot/ops.fezern8n.com/, \
    /usr/bin/systemctl restart mediaops-api mediaops-crawler-worker, \
    /www/server/nginx/sbin/nginx -t, \
    /www/server/nginx/sbin/nginx -s reload

mediaops ALL=(root) NOPASSWD: MEDIAOPS_DEPLOY
